<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | Thiranex</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>Dashboard</h1>
    <div class="status">
      <p>Logged in as <strong><%= email %></strong>.</p>
      <p>2FA enabled: <strong><%= twofaEnabled ? 'Yes' : 'No' %></strong></p>
    </div>
    <% if (!twofaEnabled) { %>
      <p>
        <a href="/2fa-setup">Enable Two-Factor Authentication</a>
      </p>
    <% } %>
    <p>
      <a href="/logout">Logout</a>
    </p>
  </div>
</body>
</html>
