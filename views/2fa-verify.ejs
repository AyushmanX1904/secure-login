<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify 2FA | Thiranex</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>2FA Verification</h1>
    <p>Please enter the code from your authenticator app.</p>
    <form action="/2fa-verify" method="post">
      <label for="token">2FA code</label>
      <input type="text" id="token" name="token" maxlength="8" required />
      <button type="submit">Verify</button>
    </form>
    <p><a href="/logout">Cancel and logout</a></p>
  </div>
</body>
</html>
